{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-game-factory.local/schemas/state.schema.json",
  "title": "game-factory state",
  "type": "object",
  "required": ["schema_version", "phase", "iteration", "updated_at"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "phase": {
      "enum": [
        "bootstrap",
        "design",
        "awaitingDesignApproval",
        "mvpBuild",
        "mvpVerify",
        "awaitingPlaytest",
        "production",
        "releaseCandidate",
        "done"
      ]
    },
    "iteration": { "type": "integer", "minimum": 0 },
    "updated_at": { "type": "string" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "approval_hashes": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "retry_counts": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    }
  }
}
